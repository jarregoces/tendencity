# Copia este archivo como .env (FUERA del web root) y llena los valores.
MASTERSHOP_API_KEY=
MASTERSHOP_BASE_URL=https://prod.api.mastershop.com

DB_HOST=localhost
DB_NAME=tienda
DB_USER=
DB_PASS=

# Token largo y aleatorio para la URL del webhook. Genéralo con:
#   php -r "echo bin2hex(random_bytes(32));"
WEBHOOK_TOKEN=
# URL pública de public/webhook.php (sin el token; el script lo agrega)
WEBHOOK_URL=https://tutienda.com/webhook.php

# Prefijo de tus IDs externos. Solo letras, números y guiones.
ORDER_PREFIX=YB

# Datos fijos de los pedidos
COUNTRY=CO
CURRENCY=COP

# URL pública de la tienda (sin barra final) y secreto para firmar enlaces
SITE_URL=https://tendencity.store
APP_SECRET=
FALLBACK_EMAIL=pedidos@tendencity.store
APP_TIMEZONE=America/Bogota
