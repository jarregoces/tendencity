# Copia este archivo como .env (FUERA del web root) y llena los valores.
MASTERSHOP_API_KEY=
MASTERSHOP_BASE_URL=https://prod.api.mastershop.com

DB_HOST=localhost
DB_NAME=tienda
DB_USER=
DB_PASS=

# Token largo y aleatorio para la URL del webhook. Genéralo con:
#   php -r "echo bin2hex(random_bytes(32));"
WEBHOOK_TOKEN=
# URL pública de public/webhook.php (sin el token; el script lo agrega)
WEBHOOK_URL=https://tutienda.com/webhook.php

# Prefijo de tus IDs externos. Solo letras, números y guiones.
ORDER_PREFIX=YB

# País de esta instalación: CO (Colombia, COP) o GT (Guatemala, GTQ).
# Cambia moneda, teléfonos, departamentos, festivos y textos.
COUNTRY=CO

# Cómo se despachan los pedidos:
#   mastershop = por API de Mastershop (Colombia)
#   dropi      = quedan en cola y Claude los crea en Dropi (usa API_TOKEN)
#   manual     = quedan en cola para despacharlos a mano
# Si lo dejas vacío: mastershop si hay MASTERSHOP_API_KEY, si no manual.
FULFILLMENT=

# Clave de la API privada /api/pedidos (la usa Claude para leer pedidos y marcarlos en Dropi).
# Mínimo 32 caracteres. Genérala con: php -r "echo bin2hex(random_bytes(32));"
API_TOKEN=

# URL pública de la tienda (sin barra final) y secreto para firmar enlaces
SITE_URL=https://tendencity.shop
APP_SECRET=
FALLBACK_EMAIL=pedidos@tendencity.shop
APP_TIMEZONE=America/Bogota
